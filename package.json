{
  "name": "indoornav-fullstack",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "client-install": "npm install --prefix client",
    "backend-install": "npm install --prefix backend",
    "server-install": "npm install --prefix backend",
    "install-all": "npm run client-install && npm run backend-install",
    "client": "npm run dev --prefix client",
    "backend": "npm run dev --prefix backend",
    "server": "npm run dev --prefix backend",
    "dev": "concurrently \"npm run client\" \"npm run backend\"",
    "seed": "node backend/scripts/seed.js",
    "validate-map": "node backend/scripts/validateMap.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.14"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mongodb": "^7.6.0",
    "mongoose": "^9.9.4"
  }
}
